# services/mod-consumer/.env — read by systemd via EnvironmentFile.
#
# NOTE the key names differ from the other consumers on this box. They use
# SUPABASE_KEY; api/_lib/modDb.js reads SUPABASE_SERVICE_ROLE_KEY (or
# SUPABASE_SERVICE_KEY) and nothing else, so SUPABASE_KEY here is silently
# ignored and every call fails on "must be set to reach the mod schema".
#
# These are the same values as the dame-is Vercel project (atpotato team).
# `vercel env pull` will write them out if you would rather not copy by hand.

# ---- Required ---------------------------------------------------------------
SUPABASE_URL=https://zdzjtziydmwkxbzlkwxv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The moderator account. MOD_IDENTIFIER is a DID, not a handle: a handle is
# rented, and botAgent verifies the session DID against this value, which is what
# catches an identifier and an app password belonging to two different accounts
# before anything is written to the wrong repo.
#
# The app password MUST have "Allow access to your direct messages" ticked. A
# plain one is excluded from chat.bsky.* and the DM loop finds nothing, silently.
# The consumer probes this at boot and says so in the log.
MOD_IDENTIFIER=did:plc:
MOD_APP_PASSWORD=

# Vercel AI Gateway.
AI_GATEWAY_API_KEY=

# The moderation list commands and approvals write to. Must be owned by the
# MODERATOR account -- the bot can only write to its own repo, so this is the
# migrated list, not the one in dame's repo.
MOD_LIST_URI=at://did:plc:.../app.bsky.graph.list/...

# ---- Optional (defaults shown) ----------------------------------------------
# MOD_AGENT_MODEL=anthropic/claude-opus-5
# MOD_OWNER_DID=did:plc:gq4fo3u6tqzzdkjlwzpb23tj   # dame; the ONLY account answered
#
# Who else is answered, besides the owner. Comma or whitespace separated DIDs.
# Handles are REJECTED at boot on purpose: a handle is rented, so an allowlist
# written in handles is one that can change hands without the list changing.
#
# MOD_ALLOWED_DIDS is READ-ONLY. Those accounts get the analyst, lookups, post
# scans, `read`, `review` and `history`; anything that changes the list is
# refused with a message saying so. They are answered on BOTH surfaces -- DMs
# and public mentions -- and their DIDs are added to the Jetstream subscription,
# without which their public mentions would never arrive at all.
#
# Worth being clear about what read-only does NOT limit: they can see bands,
# vouch counts and follower numbers for third parties, which is dame's private
# read of her own social graph, and on the public path the answer is readable by
# everyone in the thread. The tier limits what they can CHANGE, not what they
# can SEE.
# MOD_ALLOWED_DIDS=
#
# MOD_WRITER_DIDS is the upgrade path and is EMPTY BY DESIGN. An account here
# can block, approve up to 500 listitems in one message, and undo -- on a live
# list real people subscribe to. Being able to talk to the bot and being able to
# do that are different powers, and only one of them is cheap to grant.
# MOD_WRITER_DIDS=
#
# MOD_DM_MODE=classic     # or "agent". Agent mode answers DMs with one model
#                          # that holds the write tools (add, remove, scan,
#                          # triage, approve, undo) and is talked to in
#                          # sentences instead of commands and numbered menus.
#                          # Start any message with "!" to take the classic path
#                          # for that one message ("!block @x", "!help").
#                          # The roster and the PROTECTED veto still apply;
#                          # read-only guests get no write tools at all.
# MOD_OPERATOR_MODEL=      # the agent's model, if it should differ from
#                          # MOD_AGENT_MODEL. It is choosing writes from
#                          # sentences, so a stronger model is worth testing.
# MOD_OPERATOR_STEPS=24    # tool-loop steps per agent turn
# MOD_OPERATOR_TIMEOUT_MS=300000
# MOD_OPERATOR_CALL_TIMEOUT_MS=45000
#                          # one first-wave model call, tool time excluded.
#                          # Past it the call counts as stalled and the second
#                          # wave takes the turn. 0 turns the watchdog off.
# MOD_OPERATOR_REASONING=  # off | low | medium | high; unset = provider default
#
# Two waves (api/_lib/tiers.js). Cheap models do the work; a stronger one is
# asked only when the cheap ones are unsure, disagree, hand off, or fail.
# MOD_JUDGE_MODEL=typesafe-ai/jev
#                          # evaluation model: checks every agent write against
#                          # what dame said, and scores triage posts for
#                          # hostility. ~200ms, $0.04/M tokens. "off" disables.
# MOD_CHECK_MODEL=openai/gpt-6-luna
#                          # second opinion when the judge is unsure about a
#                          # write (between MOD_INTENT_REFUSE and _ALLOW)
# MOD_INTENT_ALLOW=0.6
# MOD_INTENT_REFUSE=0.2
# MOD_ESCALATION_MODEL=zai/glm-5.3-flash
#                          # takes a whole agent turn on hand-off, failure or a
#                          # "^" prefix, and re-reads every post triage would
#                          # call hostile. "off" keeps everything first-wave.
# MOD_ESCALATION_FALLBACK=zai/glm-5.3
#                          # the gateway tries this when the second-wave model
#                          # fails. "off" for none.
# MOD_ESCALATION_CALL_TIMEOUT_MS=90000
#                          # MOD_OPERATOR_CALL_TIMEOUT_MS for a second-wave
#                          # call; nothing comes after it, so it waits longer
#
# Watching posts and noticing your own taking off (docs/MODERATION.md, "In a
# DM, day to day"). Both wait for the DMs to be quiet for a minute.
# MOD_WATCH_EVERY_MS=300000  # how often watched posts are read; 0 = off
# MOD_ALERTS=on              # off = no offers to watch your own busy posts
# MOD_ALERT_THRESHOLD=15     # new quotes and replies within an hour
# MOD_ALERT_EVERY_MS=600000  # how often your recent posts are checked
#
# PUBLIC_REPLIES=true      # false leaves the DM loop running alone
# DRY_RUN=false            # true = classify and log, never post or DM
#
# DM_POLL_MS=2000          # 0.5 req/s against a documented 10/s ceiling.
#                          # Do not tune down: the model call is 5-20s, so 2s to
#                          # 500ms moves felt latency by under 10%.
# JETSTREAM_HOST=jetstream2.us-west.bsky.network
#                          # Avoid jetstream1.us-east: Cloudflare 414s long URLs.
# RECONNECT_EVERY_MS=900000
#                          # Forced reconnect. The subscription is filtered to one
#                          # DID, so silence is normal and a dead socket looks
#                          # exactly like a quiet one.
#
# DRIFT_EVERY_HOURS=168   # re-score everyone on the list this often. 0 disables.
#                         # Only what MOVED is sent, and nothing is sent at all
#                         # when nothing moved -- a brief restating 8,543
#                         # unchanged rows is one that stops being read.
# DRIFT_CHECK_MS=3600000  # how often to ask whether a run is due. The answer is
#                         # a single select, so this is not the expensive part.
#
# REFERENCE_TTL_MS=900000  # how long a loaded snapshot is reused
# REFERENCE_IDLE_MS=600000 # how long after the last question it is dropped.
#                          # 73k vouch rows on a 512 MB box with three other
#                          # services: held while in use, released when not.
#
# STATE_DIR=/root/dame.is/services/mod-consumer
# CURSOR_FILE=mod-consumer-cursor.txt
# ANSWERED_FILE=mod-consumer-answered.json
#
# LOG_LEVEL=info           # error | warn | info | debug | trace
# LOG_JSON=false
# STATS_INTERVAL_MS=1800000
