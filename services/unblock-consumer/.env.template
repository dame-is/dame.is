# services/unblock-consumer/.env — read by systemd via EnvironmentFile.
#
# Two values are needed to publish, and they are the same two the mod-consumer
# beside this uses. Note the name: SUPABASE_SERVICE_ROLE_KEY, not the
# SUPABASE_KEY the three older consumers on this box read.

# ---- Required (unless PUBLISH=false) -----------------------------------------
SUPABASE_URL=https://zdzjtziydmwkxbzlkwxv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Disk: the one setting worth deciding ------------------------------------
# The ceiling on the index, in megabytes. The index holds every block the
# network has made and not undone since tracking began, at about 62 bytes each
# and about 324,000 a day (both measured, November 2026): roughly 20 MB a day,
# so a gigabyte is about fifty days.
#
# When the ceiling is reached the oldest blocks are dropped, and an unblock of
# a block older than what is left can no longer be placed. So this number is
# how old a block can be and still have its unblock noticed:
#
#     1024   about 7 weeks
#     2048   about 14 weeks   (the default)
#     4096   about 7 months
#     8192   about 13 months
#
# The file settles a little OVER this: between 4% and 10% in a long simulation
# (the README says why), with SQLite's write-ahead log beside it (a few MB).
# Check `df -h` first and leave real headroom: this box has gone down to a
# full disk before. 0 means no ceiling.
# MAX_DB_MB=2048
#
# Or cap by age instead of (or as well as) size. 0 means no age limit.
# BLOCK_RETENTION_DAYS=0
#
# Where the index lives. Defaults to unblock-index.db in this directory.
# DB_FILE=/root/dame.is/services/unblock-consumer/unblock-index.db

# ---- Optional (defaults shown) -----------------------------------------------
# PUBLISH=true             # false keeps the index and holds the outbox, sending
#                          # nothing. Use it to watch the service work before
#                          # the Supabase schema exists; nothing is lost, and
#                          # the outbox drains when it is turned back on.
#
# BOOTSTRAP_HOURS=35       # first run only: start this far back instead of at
#                          # the live tail. Jetstream keeps about 36 hours, so
#                          # the index opens knowing a day and a half of blocks:
#                          # about 470,000 events, ahead of the live stream.
#
# JETSTREAM_HOST=jetstream2.us-west.bsky.network
# JETSTREAM_API=v1         # v2 is the newer endpoint and can filter out events
#                          # this service ignores. It is written from the docs
#                          # and has not been run against the live service, so
#                          # watch the log if you switch. Its host is
#                          # jetstream.us-west.bsky.network.
# SILENCE_MS=90000         # this stream is never quiet, so 90s of nothing is
#                          # taken for a dead socket and it reconnects.
#
# SQLITE_CACHE_KB=8000     # SQLite's page cache. Kept small for a 512 MB box.
# PUBLISH_MS=5000          # how often the outbox is sent on
# PUBLISH_BATCH=500
# STATUS_MS=60000          # how often the page's "since when, how far back" is refreshed
#
# LOG_LEVEL=info           # error | warn | info | debug | trace
# LOG_JSON=false
# STATS_INTERVAL_MS=1800000
